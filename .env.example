# Salin file ini menjadi .env.local lalu isi sesuai environment kamu.
# ⚠️ JANGAN commit .env / .env.local yang berisi key asli ke git.
#    Untuk production, set variabel-variabel ini lewat dashboard Vercel
#    (Project Settings → Environment Variables).

# Zey AI Gateway — endpoint chat completion utama untuk Zey Learn AI
ZEY_AI_GATEWAY_URL=https://zey-ai.vercel.app/api/chat
ZEY_AI_API_KEY=vvbam988

# Zey Search — sumber konteks/referensi internet tambahan
ZEY_SEARCH_API_URL=https://zey-search.vercel.app/api/search

# Zey Vault — penyimpanan dataset symbiosis (feedback & koreksi pengguna)
ZEY_VAULT_API_URL=https://zey-vault.vercel.app/api/store
ZEY_VAULT_API_KEY=vvbam988

# VWV Studio (Vazi Web Vision) — trigger fine-tuning otomatis
VWV_STUDIO_API_URL=https://vwv-studio.vercel.app/api/finetune
